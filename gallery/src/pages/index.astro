            <Callout variant={variant} title={(ground === 'page' ? { info: 'Meet at the garden table', success: 'Materials are ready', warning: 'Allow time for the walk', error: 'The form needs a date' } : { info: 'A map for the next visit', success: 'The garden gate is repaired', warning: 'Rain is expected after lunch', error: 'A meeting place is missing' })[variant]} level={3} style="outlined"><p>{{ info: 'We will begin with a short introduction.', success: 'Paper, pencils and string are on the bench.', warning: 'The path takes about twenty minutes.', error: 'Add a workshop date before sending your request.' }[variant]}</p></Callout>

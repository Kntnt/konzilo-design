---
import ContentCard from '../../../src/components/ContentCard.astro';
import ContentLoop from '../../../src/components/ContentLoop.astro';
import VisitorFilters from '../../../src/components/VisitorFilters.astro';
import Pagination from '../../../src/components/Pagination.astro';
import VideoPlayer from '../../../src/components/VideoPlayer.astro';
import Embed from '../../../src/components/Embed.astro';
import ConsentBanner from '../../../src/components/ConsentBanner.astro';
import Form from '../../../src/components/Form.astro';
import Field from '../../../src/components/Field.astro';
import { loopItems, documents, videos, topics, yearOptions, providers, galleryNote, allFields, consentCategories, consentTexts } from '../interaction-samples';
import Header from '../../../src/components/Header.astro';
import Footer from '../../../src/components/Footer.astro';
import { identity, menu, languages, search, cta, footerVariants } from '../frame-samples';
import Page from '../../../src/components/Page.astro';
import Band from '../../../src/components/Band.astro';
import Hero from '../../../src/components/Hero.astro';
import TextImage from '../../../src/components/TextImage.astro';
import CtaBand from '../../../src/components/CtaBand.astro';
import KeyFigures from '../../../src/components/KeyFigures.astro';
import Figure from '../../../src/components/Figure.astro';
import ReadingArea from '../../../src/components/ReadingArea.astro';
import AsideBlock from '../../../src/components/AsideBlock.astro';
import Sidenote from '../../../src/components/Sidenote.astro';
import BodyText from '../../../src/components/BodyText.astro';
import HeadingGroup from '../../../src/components/HeadingGroup.astro';
import Button from '../../../src/components/Button.astro';
import LinkGroup from '../../../src/components/LinkGroup.astro';
import Icon from '../../../src/components/Icon.astro';
import Card from '../../../src/components/Card.astro';
import CardGrid from '../../../src/components/CardGrid.astro';
import Table from '../../../src/components/Table.astro';
import Accordion from '../../../src/components/Accordion.astro';
import AccordionItem from '../../../src/components/AccordionItem.astro';
import Quotation from '../../../src/components/Quotation.astro';
import Callout from '../../../src/components/Callout.astro';
import Breadcrumbs from '../../../src/components/Breadcrumbs.astro';
import TableOfContents from '../../../src/components/TableOfContents.astro';
import { workshopColumns, workshopRows, totalsColumns, totalsRows, totalsFooter, wideColumns, wideRows, questions, contentsHeadings } from '../content-samples';
import { icons } from '../../../src/components/icons.js';
import { derive } from '../../../src/generator/index.js';
import { coreCss } from '../../../src/css/index.js';
import { galleryInputs, typefaceCases, typefaceChoices } from '../design.js';
import '../fonts.css';
import '../../../src/components/index.css';
import '../gallery.css';
import { landscape, portrait } from '../samples.js';
const resolved = derive(galleryInputs);
const kinds = Object.keys(resolved.surfaces);
const settings = galleryInputs;
// Each control explains itself, because the page is shown to people who did not build it.
const tips = {
  mode: 'Shows the page in light or dark mode. Page, raised and tint Surfaces follow it; brand, inverse and accent stay dark.',
  primary: 'The main brand colour. Filled buttons, links and the brand, accent and tint Surfaces are generated from it.',
  'secondary-enabled': 'Adds a second brand colour. Accents and focus rings then take it, and it gets a tint Surface of its own.',
  secondary: 'The second brand colour. It has an effect only while Secondary on is ticked.',
  'main-typeface': 'The family for practically all content. The system stacks need no font file. A serif works as well as a sans-serif.',
  'heading-typeface': 'Headings follow the main typeface unless you choose otherwise, for example a sans-serif above serif text.',
  'monospace-typeface': 'The family for code, and for labels when Labels is set to Monospace. Without a deliberate choice it is the system stack.',
  label: 'The small text around headings: eyebrows, metadata and categories. They are always in capitals, in either the main family, the default, or the monospace family. Choosing Monospace also picks Geist Mono, if the system stack was selected.',
  corner: 'How rounded buttons and cards are, from square through almost square to clearly rounded.',
  density: 'How much air the design has, from very compact to very loose. It scales the space inside cards, between columns and around bands. Applies when you release the slider.',
  strength: 'How strong the shadows are; 0 turns them off. Here they show on cards with a Surface of their own.',
  hardness: "How sharp the shadow's edge is, from soft and diffuse to a solid offset at 100. It shows only when Shadow is above 0.",
  frame: 'A solid outline around buttons and cards with a Surface of their own, from 0 to 3 pixels; 0 means none. Applies when you release the slider.',
};
const sliders = [
  { id: 'corner', label: 'Corners', value: settings['corner-profile'], max: 100, step: 1 },
  { id: 'density', label: 'Density', value: settings['density-profile'], max: 100, step: 1 },
  { id: 'strength', label: 'Shadow', value: settings.shadow.strength, max: 100, step: 1 },
  { id: 'hardness', label: 'Hardness', value: settings.shadow.hardness, max: 100, step: 1 },
  { id: 'frame', label: 'Frame', value: settings.frame.width, max: 3, step: 0.1 },
];
const picture = { src: landscape, alt: 'Abstract hills beneath a round sun', loading: 'eager' as const };
const headshot = { src: portrait, alt: 'Neutral portrait silhouette', loading: 'eager' as const };
// A plate shows only where its colour differs from the band it lies on. Plated and unplated
// cards get rows of their own, because a site does not mix them in one row.
const plates = { page: ['raised', 'tint', 'brand'], tint: ['raised', 'page', 'brand'], brand: ['raised', 'tint', 'page'] } as const;
const linkText = 'Find a clear starting point for your next shared project.';
const articleText = 'A walk through the ordinary reveals a few unexpected possibilities.';
const article = { picture, meta1: [{ text: '20 October 2026', datetime: '2026-10-20' }, { text: 'Field notes' }], text: articleText, href: '#body-text' } as const;
const person = { variant: 'person', picture: headshot, personRole: 'Workshop coordinator', email: 'studio@example.invalid', phone: '+1 202 555 0148' } as const;
const cardSamples = {
  Link: [
    { heading: 'A place to begin', eyebrow: 'Studio notes', icon: 'globe', text: linkText, href: '#body-text' },
    { heading: 'An open invitation', eyebrow: 'Studio notes', icon: 'mail', text: linkText, href: '#body-text' },
    { heading: 'Notes from the bench', eyebrow: 'Studio notes', icon: 'file-text', text: linkText, href: '#body-text' },
  ],
  Article: [
    { ...article, heading: 'A new view of familiar places' },
    { ...article, heading: 'What we noticed along the way' },
    { ...article, heading: 'Three questions worth asking' },
  ],
  Person: [
    { ...person, heading: 'Rowan Vale' },
    { ...person, heading: 'Ellis Reed' },
    { ...person, heading: 'Noor Lind' },
  ],
} as const;
const figures = [{ value: '24', label: 'Shared workshops', note: 'Across four seasons' }, { value: '1,280', label: 'Pages in the notebook' }, { value: '96%', label: 'Materials used again' }, { value: '18', label: 'Neighbourhood gardens' }];
const runningText = 'We followed the path past the old bridge and stopped where the trees opened onto a meadow. Each person noticed something different: the curve of the bank, the sound of water, a place to sit. Back at the shared table, these small observations became a set of sketches. We tested the simplest ideas first, leaving space for people to add their own experience. A useful place grows through this patient exchange, one ordinary detail at a time.';
const labChoices = [
  { name: 'arrangement', label: 'Arrangement', options: ['A', 'B', 'C'], tip: 'The three fixed arrangements set the link menu and search icon in their approved groups.' },
  { name: 'headerAttachment', label: 'Header', options: ['sticky', 'flow'], tip: 'Sticky holds the header at the window’s top. Flow scrolls with the page.' },
  { name: 'start', label: 'Page start', options: ['below', 'under'], tip: 'Under puts the first band behind a sticky header, which takes that band’s Surface at the top.' },
  { name: 'surface', label: 'Opaque Surface', options: ['page', 'brand'], tip: 'The header takes this complete Surface after the first 24 pixels of scrolling.' },
  { name: 'firstBand', label: 'First band', options: ['dark', 'light'], tip: 'The first band supplies every context role while the header is transparent.' },
  { name: 'footerAttachment', label: 'Footer', options: ['flow', 'reveal'], tip: 'Reveal holds the footer behind the page only while the entire footer fits in the window.' },
];
const labChecks = [
  { name: 'autohide', label: 'Autohide', checked: false, tip: 'Slides the sticky header away on downward scrolling and brings it back on upward scrolling.' },
  ...['slogan', 'name', 'links', 'language', 'search', 'cta'].map((name) => ({ name, label: ({ links: 'Link menu', cta: 'CTA' })[name] ?? name[0].toUpperCase() + name.slice(1), checked: true, tip: `Shows the ${({ links: 'link menu', language: 'language switcher', search: 'search icon', cta: 'CTA button' })[name] ?? name} in its fixed place. Functional items move into the megamenu when room runs out.` })),
  { name: 'pageShadow', label: 'Page shadow', checked: false, tip: 'The Page casts its shadow on the footer. At zero shadow strength the visible edge uses a hairline.' },
  { name: 'short', label: 'Short page', checked: false, tip: 'Hides the long reading bands. The footer stays at the window’s bottom with the page Surface filling the space above.' },
];
const filterTitles = ['Gathering around the orchard table', 'Listening to the morning birds', 'A shelter for rainy afternoons', 'Sketches beside the footbridge', 'The old greenhouse door', 'A place to exchange seeds', 'Learning the names of trees', 'A bench facing the sunrise', 'The shape of a useful tool', 'Drawing a path together', 'Stories carried by the river', 'A workshop for winter evenings', 'Repairing the garden gate', 'Making room for a neighbour', 'The last leaf in the notebook'];
const filteredItems = loopItems.map((item, index) => ({ ...item, title: filterTitles[index] }));
const filterCardTitles = ['Following a trail of questions', 'An open cupboard of materials', 'The sound of the courtyard', 'A model made from offcuts', 'Paths between shared gardens', 'Letters from the workshop'];
const searchTitles = ['A useful place to pause', 'Starting with a blank page', 'Keeping the small discoveries', 'What we learned from the rain'];
const accordionLabels = [
  [['Preparing for a first visit', 'Where should we meet?'], ['What is on the workbench?', 'Which materials can I bring?']],
  [['Following the orchard path', 'How long does the walk take?'], ['Keeping a record of the day', 'May I share a drawing?']],
  [['Opening the garden for winter', 'When do the gates close?'], ['Making a model together', 'Do I need any experience?']],
  [['Listening after the evening walk', 'What did we notice in the dark?'], ['Planning the next gathering', 'Can a neighbour join us?']],
];
const contentChoices = [
  { name: 'presentation', label: 'Presentation', options: [['cards', 'Cards'], ['rows', 'Rows']], tip: 'Uses the same rendered content as Content Cards or Content Rows in sections 39, 40 and 41.' },
  { name: 'ratio', label: 'Picture ratio', options: [['3:2', '3:2'], ['2:1', '2:1 (cards)'], ['1:1', '1:1 (rows)']], tip: 'Cards offer 3:2 or 2:1 pictures. Rows offer 3:2 or square pictures.' },
  { name: 'metadata', label: 'Metadata place', options: [['1', 'Above heading'], ['2', 'Below heading'], ['both', 'Both places']], tip: 'Places metadata above or below the heading. Both puts the category above and author and date below.' },
  { name: 'separator', label: 'Separator', options: [['dot', 'Dot'], ['comma', 'Comma'], ['bar', 'Bar'], ['none', 'None']], tip: 'A decorative separator between metadata values; never next to a category pill.' },
  { name: 'cta', label: 'Read more', options: [['link', 'Link'], ['none', 'None'], ['button', 'Outline button']], tip: 'Adds a separate content link or outline Button after the text, with the title in its accessible name.' },
  { name: 'cta-icon', label: 'CTA icon', options: [['→', '→'], ['', 'None'], ['›', '›'], ['»', '»'], ['➔', '➔']], tip: 'Adds a decorative text arrow at the end of the CTA. It reverses in right-to-left text.' },
  { name: 'surface', label: 'Card Surface', options: Object.keys(resolved.surfaces).filter((kind) => !kind.startsWith('picture-')).sort((a, b) => a === 'raised' ? -1 : b === 'raised' ? 1 : a.localeCompare(b)).map((kind) => [kind, kind]), tip: 'Selects the complete checked Surface for plated content. Unplated content inherits its band.' },
  { name: 'columns', label: 'Columns', options: [['3', 'Three'], ['1', 'One'], ['2', 'Two'], ['4', 'Four']], tip: 'The maximum card column count. The grid reduces its count when there is less room.' },
];
const contentChecks = [
  { name: 'images', label: 'Pictures', checked: true, tip: 'Shows pictures on every row, preserving a placeholder where an item has no picture.' },
  { name: 'inset', label: 'Picture gap', checked: false, tip: 'Keeps a plated card’s picture inside the padding instead of flush to its three outer edges.' },
  { name: 'author', label: 'Author', checked: true, tip: 'Shows the author metadata and its independent link to the notebook.' },
  { name: 'date', label: 'Date', checked: true, tip: 'Shows a publication time with a machine-readable date.' },
  { name: 'category', label: 'Category', checked: true, tip: 'Shows the category metadata and its own link.' },
  { name: 'pill', label: 'Category pill', checked: false, tip: 'Renders the category as a small uppercase pill using the shared checked Button colours.' },
  { name: 'text', label: 'Short text', checked: true, tip: 'Shows the optional summary or marked search excerpt after the metadata.' },
  { name: 'plated', label: 'Plated', checked: true, tip: 'Gives the item its own Surface. A plated card also gets the shared frame and lifted hover shadow.' },
];
const contentPresets = [
  { name: 'Editorial cards', meta: 'all', titles: ['A corner worth keeping', 'Riverbank conversations', 'The first shared drawing'], props: { surface: 'raised', cta: { label: 'Read the story', style: 'link', icon: '→' } } },
  { name: 'Inset picture cards', meta: 'all', titles: ['A room for making', 'Drawing with neighbours', 'Tools that tell a story'], props: { surface: 'tint', imageInset: true, imageRatio: '2:1', cta: { label: 'Explore', style: 'button', icon: '›' } } },
  { name: 'Category-led stories', meta: 'pill', titles: ['An orchard in autumn', 'The paper lantern workshop', 'Gathering seeds together'], props: { surface: 'raised' } },
  { name: 'A simple reading list', meta: 'all', titles: ['Where the footpath bends', 'The value of a pause', 'An unexpected meeting'], props: { presentation: 'rows', images: false, metaSeparator: 'bar' } },
  { name: 'Picture-led rows', meta: 'all', titles: ['Looking across the water', 'A sketch of the clearing', 'The garden after rain'], props: { presentation: 'rows', imageRatio: '1:1', cta: { label: 'Continue', style: 'link', icon: '»' } } },
  { name: 'Quiet text cards', meta: 'none', titles: ['Leave a page open', 'A thought to take home', 'Questions for next time'], props: { images: false, columns: 3, cta: { label: 'Open note', style: 'link' } } },
] as const;
const bandRows = { page: ['Link', 'Article', 'Person'], tint: ['Link', 'Article'], brand: ['Link', 'Article'] } as const;
---
<!doctype html>
<html lang="en" data-kn-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Konzilo components, with live design controls and self-contained examples." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath fill='%23168b83' d='M3 3h18v18H3z'/%3E%3C/svg%3E" />
    <title>Konzilo — Component gallery</title>
    <style is:inline id="kn-live-core" set:html={coreCss(resolved)} />
  </head>
  <body>
    <Page>
    <header slot="header" class="g-controls" data-kn-surface="page" data-expanded="false" data-status="passed">
      <div class="g-toolbar">
        <p class="g-control-title">Konzilo / Live design</p>
        <button class="g-toggle" type="button" aria-expanded="false" aria-controls="g-design-controls"><Icon name="menu" />Design controls</button>
        <p class="g-status" role="status" aria-live="polite">Contrast passed · all Surfaces, both modes</p>
      </div>
      <form class="g-form" id="g-design-controls" aria-label="Live design controls">
        <label class="g-field"><span>Mode</span><select name="mode" aria-describedby="g-tip-mode"><option value="light">Light</option><option value="dark">Dark</option></select><span class="g-tip" id="g-tip-mode" role="tooltip" aria-hidden="true" data-kn-surface="inverse">{tips['mode']}</span></label>
        <label class="g-field"><span>Primary colour</span><input type="color" name="primary" aria-describedby="g-tip-primary" value={settings['brand-colors'].primary} /><span class="g-tip" id="g-tip-primary" role="tooltip" aria-hidden="true" data-kn-surface="inverse">{tips['primary']}</span></label>
        <label class="g-field"><span>Secondary on</span><input type="checkbox" name="secondary-enabled" aria-describedby="g-tip-secondary-enabled" checked={Boolean(settings['brand-colors'].secondary)} /><span class="g-tip" id="g-tip-secondary-enabled" role="tooltip" aria-hidden="true" data-kn-surface="inverse">{tips['secondary-enabled']}</span></label>
        <label class="g-field"><span>Secondary colour</span><input type="color" name="secondary" aria-describedby="g-tip-secondary" value={settings['brand-colors'].secondary ?? '#b66c32'} /><span class="g-tip" id="g-tip-secondary" role="tooltip" aria-hidden="true" data-kn-surface="inverse">{tips['secondary']}</span></label>
        <label class="g-field"><span>Main typeface</span><select name="main-typeface" aria-describedby="g-tip-main-typeface">{typefaceChoices.main.map(({ label, value }) => <option value={value}>{label}</option>)}</select><span class="g-tip" id="g-tip-main-typeface" role="tooltip" aria-hidden="true" data-kn-surface="inverse">{tips['main-typeface']}</span></label>
        <label class="g-field"><span>Headings</span><select name="heading-typeface" aria-describedby="g-tip-heading-typeface">{typefaceChoices.heading.map(({ label, value }) => <option value={value}>{label}</option>)}</select><span class="g-tip" id="g-tip-heading-typeface" role="tooltip" aria-hidden="true" data-kn-surface="inverse">{tips['heading-typeface']}</span></label>
        <label class="g-field"><span>Monospace</span><select name="monospace-typeface" aria-describedby="g-tip-monospace-typeface">{typefaceChoices.monospace.map(({ label, value }) => <option value={value}>{label}</option>)}</select><span class="g-tip" id="g-tip-monospace-typeface" role="tooltip" aria-hidden="true" data-kn-surface="inverse">{tips['monospace-typeface']}</span></label>
        <label class="g-field"><span>Labels</span><select name="label" aria-describedby="g-tip-label"><option value="main">Main typeface</option><option value="monospace">Monospace</option></select><span class="g-tip" id="g-tip-label" role="tooltip" aria-hidden="true" data-kn-surface="inverse">{tips['label']}</span></label>
        {sliders.map(({ id, label, value, max, step }) => <label class="g-field" for={`g-${id}`}><span class="g-field-label">{label}<output for={`g-${id}`} id={`g-${id}-value`}>{value}</output></span><input id={`g-${id}`} name={id} type="range" min="0" max={max} step={step} value={value} aria-describedby={`g-tip-${id}`} /><span class="g-tip" id={`g-tip-${id}`} role="tooltip" aria-hidden="true" data-kn-surface="inverse">{tips[id]}</span></label>)}
      </form>
    </header>
      <Band surface="page">
        <HeadingGroup level={1} type="display" eyebrow="Konzilo Design System / 0.2" heading="A common language for the web" deck="A growing library, one set of roles. Explore an invented studio's content and change the design as you go." />
      </Band>
      <Band surface="page" id="typefaces">
        <HeadingGroup class="g-section-heading" heading="Typefaces" deck="One sans-serif throughout is the norm. Every exception takes one choice or one line of CSS." />
        <div class="g-typefaces">
          {typefaceCases.map(({ name, how, style, note }) => <div class="g-typeface-case">
            <h3 class="g-typeface-name">{name}</h3>
            <p class="g-typeface-note">{note} <code>{how}</code></p>
            <div class="g-typeface-specimen" style={style}>
              <p data-kn-type="label">Field notes / Autumn</p>
              <p data-kn-type="display">Large text</p>
              <p data-kn-type="heading-1">First heading</p>
              <p data-kn-type="heading-3">A lower heading</p>
              <p data-kn-type="body">Running text, with <code data-kn-type="mono">code</code> in the monospace family.</p>
            </div>
          </div>)}
        </div>
      </Band>
      <Band surface="page" id="body-text">
        <HeadingGroup class="g-section-heading" heading="01 / Body Text" deck="Running text keeps its rhythm wherever it lives." />
        <BodyText class="g-reading">
          <h3>Small ideas, thoughtfully made</h3>
          <p>At Juniper Atlas, we make room for useful ideas. A notebook, a shared table and a clear question are often enough to begin. This is sample content for an invented studio.</p>
          <p>A good starting point brings <strong>clarity and care</strong> together. We keep the details <em>open to discovery</em>, and share what we learn through <a href="#cards">stories from the workshop</a>.</p>
          <h4>A practical rhythm</h4>
          <ul><li>Look closely at the everyday experience.</li><li>Make a small version that people can try.<ul><li>Keep the useful parts.</li><li>Ask what could be clearer.</li></ul></li><li>Leave room for the next idea.</li></ul>
          <h5>Three steps to a first draft</h5>
          <ol><li>Choose one question.</li><li>Sketch a possible answer.</li><li>Read it together and revise.</li></ol>
          <blockquote><p>The most useful detail is the one that helps someone take the next step.</p></blockquote>
          <hr />
          <h6>A note on the details</h6>
          <p>Use <code>currentColor</code> for a mark that follows its text. A small footnote<sup>1</sup> and a formula such as H<sub>2</sub>O should sit comfortably in a sentence.</p>
          <p><small>1. These words and every illustration on this page are neutral examples.</small></p>
        </BodyText>
      </Band>
      <Band surface="tint">
        <HeadingGroup class="g-section-heading" heading="02 / Heading Group" />
        <div class="g-heading-samples">
          <HeadingGroup level={3} type="display" eyebrow="New perspectives" heading="Make space for what matters" deck="A display style for a generous opening." />
          <HeadingGroup level={3} type="heading-2" eyebrow="Shared practice" heading="Good work begins with listening" deck="A clear introduction to the next part of the story." />
          <HeadingGroup level={3} type="heading-5" eyebrow="From the notebook" heading="A smaller thought, just as considered" deck="The visual style changes independently of the heading's semantic level." />
        </div>
      </Band>
      <Band surface="page" id="buttons">
        <HeadingGroup class="g-section-heading" heading="03 / Buttons and Link Group" deck="The same actions inherit a checked palette on every Surface." />
        <div class="g-stack">
          {kinds.map((kind) => <div class="g-surface-row" data-kn-surface={kind} data-g-surface-kind={kind} hidden={!resolved.surfaces[kind]} style={kind.startsWith('picture-') ? { '--kn-picture-image': `url("${landscape}")` } : undefined}>
            <h3 class="g-surface-name" data-kn-type="heading-5">{kind}</h3>
            <LinkGroup><Button href="#cards" icon="plus">Explore ideas</Button><Button href="#icons" variant="outline" icon="download">View collection</Button><Button href="#grid" variant="arrow">See the details</Button></LinkGroup>
          </div>)}
        </div>
      </Band>
      <Band surface="raised" id="icons">
        <HeadingGroup class="g-section-heading" heading="04 / Icon" deck="Lucide marks follow their text in size and colour." />
        <ul class="g-icon-grid">{Object.keys(icons).map((name) => <li class="g-icon-sample" data-kn-type="small"><Icon name={name as keyof typeof icons} /><span>{name}</span></li>)}</ul>
      </Band>
      {(['page', 'tint', 'brand'] as const).map((ground, bandIndex) => <Band surface={ground} id={bandIndex === 0 ? 'cards' : undefined} contentClass="g-stack">
        <HeadingGroup heading={`05 / Cards on ${ground}`} deck="A card with its own Surface is a plate. Without one it lies directly on the band, under a hairline or with a picture in its place." />
        {bandRows[ground].map((name) => <>
          <div><h3 class="g-grid-label" data-kn-type="heading-5">{name}, with a Surface</h3><CardGrid>
            {cardSamples[name].map((card, i) => <Fragment>{name === 'Article' ? <ContentCard {...card} title={card.heading} surface={plates[ground][i]} /> : <Card {...card} surface={plates[ground][i]} />}</Fragment>)}
          </CardGrid></div>
          <div><h3 class="g-grid-label" data-kn-type="heading-5">{name}, without a Surface</h3><CardGrid>
            {cardSamples[name].map((card) => <Fragment>{name === 'Article' ? <ContentCard {...card} title={card.heading} /> : <Card {...card} />}</Fragment>)}
          </CardGrid></div>
        </>)}
      </Band>)}
      <Band surface="page" id="grid" contentClass="g-stack">
        <HeadingGroup heading="06 / Card Grid" deck="Two, three or four columns at most. Each grid steps down when its cards need more room." />
        {([2, 3, 4] as const).map((columns) => <div><h3 class="g-grid-label" data-kn-type="heading-5">Up to {columns} columns</h3><CardGrid columns={columns}>
          {Array.from({ length: columns * 2 }, (_, i) => <Card heading={['Observe', 'Imagine', 'Make', 'Share'][i % 4]} eyebrow={`Step ${i + 1}`} text="One useful idea, ready to grow through a little shared attention." href="#body-text" surface="raised" />)}
        </CardGrid></div>)}
      </Band>

      <Hero id="hero" variant="picture" level={2} eyebrow="07 / Hero · Picture" heading="A wider view begins nearby" deck="A shared walk can change the way we see a familiar place." picture={landscape} alt="Invented green hills beneath a golden sun">
        <LinkGroup><Button href="#reading-area">Read the field notes</Button><Button href="#text-image" variant="arrow">Explore the studio</Button></LinkGroup>
      </Hero>

      </Hero>
      <Hero variant="plate" surface="picture-dark" picture={landscape} level={2} eyebrow="07 / Hero · Full-bleed picture" heading="Follow the path beyond the familiar" deck="The generated picture Surface checks its scrim against the lightest and darkest image samples.">

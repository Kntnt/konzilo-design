          <BodyText><h3>A little more time in the meadow</h3>{Array.from({ length: 9 }, () => <p>{runningText}</p>)}</BodyText>
        </ReadingArea>
      </Band>
      <Band surface="tint" id="band-run"><HeadingGroup heading="13 / A run of two tint bands · First" deck="The first band gives up its padding at the shared edge." /></Band>
      <Band surface="tint"><HeadingGroup heading="13 / A run of two tint bands · Second" deck="The second band supplies the smaller run gap." /></Band>
      <Band surface="page" id="frame-lab">

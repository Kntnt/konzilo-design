      </Band>
      <Band surface="raised" id="consent-banner">
        <HeadingGroup class="g-section-heading" heading="45 / Consent Banner" deck="Open the banner inside the frame lab to try equal-weight acceptance and refusal, custom settings and the footer’s Preferences link." />
        <Button id="g-show-consent" variant="outline" aria-describedby="g-tip-consent">Open banner in frame lab</Button>
        <span class="g-consent-tip g-tip" id="g-tip-consent" role="tooltip" data-kn-surface="inverse">Opens the non-modal consent banner inside section 14’s frame. The surrounding gallery stays readable.</span>
        <p class="g-note"><a href="#frame-lab">Go to the frame lab</a> to review the banner and settings.</p>
      </Band>
    <footer slot="footer"><Band class="g-footer" surface="inverse"><p data-kn-type="small">Konzilo component gallery · Juniper Atlas is an invented studio.</p><p><a id="cookie-policy" href="#consent-banner" data-kn-consent-open>Cookie policy and choices</a></p></Band></footer>
    </Page>
    <ConsentBanner id="gallery-consent" categories={consentCategories} texts={consentTexts} storageKey="kn-gallery-consent" deferred reopenButton={false} policyHref="#cookie-policy" />
    <script id="g-initial-inputs" type="application/json" is:inline set:html={JSON.stringify(galleryInputs).replace(/</g, '\\u003c')} />
    <script>
      import { derive } from '../../../src/generator/index.js';
      import { coreCss } from '../../../src/css/index.js';
      import { setupContentControls } from '../content-controls.js';
      import { setupTooltips } from '../tooltips.js';
      import { setupControls } from '../controls.js';
      import { setupGalleryLab } from '../lab.js';
      import { hasConsent, setConsent } from '../../../src/components/consent.js';
      const onChange = setupGalleryLab();
      setupControls({ derive, coreCss, onChange });
      const embedChoice = document.getElementById('g-embed-consent');
      if (embedChoice?.elements) {
        const syncEmbedChoice = () => { embedChoice.elements.namedItem('g-embed-choice').value = hasConsent('external-media') ? 'yes' : 'no'; };
        embedChoice.addEventListener('change', (event) => setConsent({ 'external-media': event.target.value === 'yes' }));
        window.addEventListener('kn:consentchange', syncEmbedChoice);
        syncEmbedChoice();
      }
      if (typeof window !== 'undefined') {
        setupContentControls(); setupTooltips();
        document.getElementById('g-show-consent')?.addEventListener('click', () => {
          document.getElementById('g-frame-lab')?.contentWindow?.postMessage({ type: 'kn-frame-consent' }, '*');
          document.getElementById('frame-lab')?.scrollIntoView({ block: 'start' });
        });
        document.querySelectorAll('.g-demo-form').forEach((form) => form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (form.checkValidity()) document.getElementById('forms-status').textContent = 'The example form is valid. Thank you for trying it.';
        }));
      }
    </script>
  </body>
</html>

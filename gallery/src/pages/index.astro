          {labChoices.map((control) => <label class="g-field"><span>{control.label}</span><select name={control.name} aria-describedby={`g-lab-tip-${control.name}`}>{control.options.map((option) => <option value={option}>{option}</option>)}</select><span id={`g-lab-tip-${control.name}`} class="g-tip" role="tooltip" aria-hidden="true" data-kn-surface="inverse">{control.tip}</span></label>)}
          {labChecks.map((control) => <label class="g-field"><span>{control.label}</span><input type="checkbox" name={control.name} checked={control.checked} aria-describedby={`g-lab-tip-${control.name}`} /><span id={`g-lab-tip-${control.name}`} class="g-tip" role="tooltip" aria-hidden="true" data-kn-surface="inverse">{control.tip}</span></label>)}
          <label class="g-field g-lab-width"><span class="g-field-label">Frame width<output id="g-lab-width-value">Full</output></span><input type="range" name="lab-width" min="320" max="1440" step="1" value="1440" aria-describedby="g-lab-tip-width" /><span id="g-lab-tip-width" class="g-tip" role="tooltip" aria-hidden="true" data-kn-surface="inverse">Moves from 320 pixels to the full available width. Only the frame changes size while you drag.</span></label>

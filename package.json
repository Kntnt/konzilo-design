    "schema",
    "src/components",
    "src/css",
    "src/design-md",
    "src/fonts/catalog.js",
    "src/generator",
    "src/konzilo"
  ],
  "exports": {
    "./generator": "./src/generator/index.js",
    "./css": "./src/css/index.js",
    "./design-md": "./src/design-md/index.js",
    "./design-props": "./src/components/design-props.js",
    "./components/*": "./src/components/*",
    "./components.css": "./src/components/index.css",
    "./konzilo": "./src/konzilo/index.js",
    "./konzilo.css": "./src/konzilo/konzilo.css",
    "./body-styles.css": "./src/konzilo/body-styles.css"
  },
  "devDependencies": {
    "astro": "7.4.2",
    "css-tree": "3.2.1",
    "playwright-core": "1.64.1"

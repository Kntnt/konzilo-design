{
  "name": "@kntnt/konzilo-design",
  "version": "0.6.1",
  "description": "A design system generator with a visual tool: from a few inputs, a checked design system for any website, with a presentation, CSS, components and a DESIGN.md export.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Kntnt Sweden AB",
  "homepage": "https://github.com/Kntnt/konzilo-design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kntnt/konzilo-design.git"
  },
  "bugs": {
    "url": "https://github.com/Kntnt/konzilo-design/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "gallery": "ASTRO_TELEMETRY_DISABLED=1 astro build --root gallery && node gallery/inline.mjs",
    "tool": "node bin/konzilo-design.js tool"
  },
  "bin": {
    "konzilo-design": "./bin/konzilo-design.js"
  },
  "files": [
    "bin/konzilo-design.js",
    "SITE-EXCEPTION.md",
    "src/cli/backup.js",
    "docs/spec/konzilo.md",
    "docs/spec/names.md",
    "schema",
    "src/components",
    "src/css",
    "src/design-md",
    "src/directives",
    "src/fonts/catalog.js",
    "src/generator",
    "src/konzilo"
  ],
  "exports": {
    "./generator": "./src/generator/index.js",
    "./css": "./src/css/index.js",
    "./design-md": "./src/design-md/index.js",
    "./design-props": "./src/components/design-props.js",
    "./directives": "./src/directives/index.js",
    "./components/*": "./src/components/*",
    "./components.css": "./src/components/index.css",
    "./konzilo": "./src/konzilo/index.js",
    "./konzilo.css": "./src/konzilo/konzilo.css",
    "./body-styles.css": "./src/konzilo/body-styles.css"
  },
  "devDependencies": {
    "astro": "7.4.2",
    "css-tree": "3.2.1",
    "playwright-core": "1.64.1",
    "satteri": "0.10.5"
  },
  "peerDependencies": {
    "astro": "^7"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  }
}

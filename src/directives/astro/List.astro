---
// The directive `list` (docs/spec/directives.md): A styled list: description, values, logos, actions, or a list with markers, drawn from its tree with the page's context. A Konzilo
// site registers it by DESIGN_DIRECTIVES of @kntnt/konzilo-design/konzilo.
import { contextOf } from '../render/context.js';
import { renderDirective } from '../render/render.js';

const { content, 'data-konzilo-block': block, ...attributes } = Astro.props;
---
<Fragment set:html={renderDirective('list', attributes, content, contextOf(Astro), { block })} />

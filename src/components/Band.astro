---
import type { HTMLAttributes } from 'astro/types';
import type { Surface } from './frame-types';
import { bandPictureRatio, bandPictureSizes } from '../konzilo/images.js';
// Background and vertical rhythm belong to the band; its content shares the page rail.
// A picture behind the text is an <img> after the content, which the CSS lays under the picture Surface's scrim and the
// text (band.css), so a browser loads the version of `srcset` near the width it is drawn at. Only a picture Surface has
// the scrim the text is checked on, so a band on any other draws no picture. Its address is written as given, as every
// picture's.
interface Props extends HTMLAttributes<'section'> {
  surface?: Surface;
  picture?: string;
  // What the picture shows; empty, a picture a screen reader passes over, where a template leaves it out.
  alt?: string;
  // The picture's versions with their `w` widths, as Astro's getImage() gives them in `srcSet.attribute`, and its own
  // width and height, as in its `attributes`, which a `srcset` requires, by which the band works out its `sizes`: it
  // covers the band, as wide as the window, or wider where the band is taller than the picture's proportions
  // (konzilo.md, Images). A `sizes` given is written as it is.
  srcset?: string;
  sizes?: string;
  pictureWidth?: number;
  pictureHeight?: number;
  contentClass?: string;
}
const { surface, picture, alt = '', srcset, sizes, pictureWidth, pictureHeight, contentClass, class: className, ...attributes } = Astro.props;
const behind = picture && surface?.startsWith('picture-');
// A band as tall as its text: the window's width, which is all a sizes can know of it. A Hero gives its own, by its
// height.
const ratio = bandPictureRatio('Band', { srcset, pictureWidth, pictureHeight });
const drawn = sizes ?? (srcset ? bandPictureSizes({ ratio }) : undefined);
---
<section {...attributes} class:list={['kn-band', className]} data-kn-surface={surface}>
  <div class:list={['kn-band-content', contentClass]}><slot /></div>
  {behind && <img class="kn-band-picture" src={picture} srcset={srcset} sizes={drawn} width={pictureWidth} height={pictureHeight} alt={alt} loading="eager" />}
</section>

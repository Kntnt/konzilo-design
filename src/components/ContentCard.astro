---
import type { HTMLAttributes } from 'astro/types';
import type { ContentParts } from './interaction-types';
import type { Surface } from './frame-types';
import ContentSummary from './ContentSummary.astro';
interface Props extends Omit<HTMLAttributes<'article'>, 'title'>, ContentParts {
  surface?: Surface; imageRatio?: '2:1' | '3:2'; imageInset?: boolean;
}
const { surface, picture, imageRatio = '3:2', imageInset = false, class: className, title, href, level, type, meta1, meta2, metaSeparator, text, excerpt, cta, kind, fileType, fileSize, linkAttributes, ...attributes } = Astro.props;
---
<article {...attributes} class:list={['kn-card', 'kn-content-card', className]} data-kn-surface={surface} data-kn-image-ratio={imageRatio} data-kn-image-inset={String(imageInset)}>
  {picture && <a {...linkAttributes} class="kn-content-picture" href={href} aria-hidden="true" tabindex="-1"><img src={picture.src} alt="" loading={picture.loading ?? 'lazy'} /></a>}
  <ContentSummary {...{title, href, level, type, meta1, meta2, metaSeparator, text, excerpt, cta, kind, fileType, fileSize, linkAttributes}} />
</article>

---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'nav'> { items: { label: string; href?: string }[]; label?: string }
const { items, label = 'Breadcrumb', class: className, ...attributes } = Astro.props;
---
{items.length >= 2 && <nav {...attributes} class:list={['kn-breadcrumbs', className]} aria-label={label} data-kn-type="small">
  <ol role="list">{items.map((item, index) => <li>
    {index > 0 && <span class="kn-breadcrumbs-separator" aria-hidden="true" />}
    {index === items.length - 1 ? <span aria-current="page">{item.label}</span> : item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
  </li>)}</ol>
</nav>}

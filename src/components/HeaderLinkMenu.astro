---
import type { MenuItem } from './frame-types';
interface Props { items: MenuItem[]; label?: string }
const { items, label = 'Main' } = Astro.props;
---
<nav class="kn-header-link-menu" aria-label={label}><ul>{items.filter((item) => item.linkMenu !== false).map((item) => <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>)}</ul></nav>

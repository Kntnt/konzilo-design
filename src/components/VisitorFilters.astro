---
import type { HTMLAttributes } from 'astro/types';
import type { FieldOption } from './interaction-types';
import { nextId } from './ids.js';
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { Level, FrameLink } from './frame-types';
import { filterGroups, filterKeys } from './visitor-filters.js';
interface Props extends HTMLAttributes<'form'> {
  for?: string; variant?: 'filters' | 'search'; search?: { label: string; value?: string };
  heading?: string; level?: Level; suggestions?: FrameLink[];
  toggles?: { name: string; label: string; options: FieldOption[]; values?: string[] }[];
  select?: { name: string; label: string; options: FieldOption[]; value?: string };
  instant?: boolean; submitLabel?: string; countText?: string; total?: number;
}
// No script (docs/spec/principles.md). With `instant`, the default, the whole list is on the page, and the pills and the
// select filter its items at once by CSS, through the keys Content Loop's `filteredBy` gives them. Without it the site's
// server pages the list, and the controls apply only when the form is sent, as an ordinary GET form.
const { for: target, variant = 'filters', heading = 'Search', level = 2, suggestions = [], search, toggles = [], select, instant = true, submitLabel = 'Search', countText = '{count} of {total} results', total = 0, action = '', id = nextId('kn-visitor-filters'), class: className, ...attributes } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
const filterNames = [...toggles.map(({ name }) => name), ...(select ? [select.name] : [])];
if (new Set(filterNames).size !== filterNames.length || filterNames.some((name) => !/^[a-z][a-z0-9-]*$/.test(name) || ['q', 'page', 'constructor', 'prototype'].includes(name))) throw new TypeError('Filter names must be distinct stable keys other than q and page');
const keys = instant ? filterKeys(filterGroups({ toggles, select })) : new Map();
const key = (name: string, value: string) => keys.get(name)?.get(value);
const controls = target && instant ? target : undefined;
---
<form {...attributes} id={id} class:list={['kn-visitor-filters', className]} role="search" method="get" action={action} data-kn-variant={variant}>
  {variant === 'search' ? <div class="kn-search-box" data-kn-surface="inverse">
    <div class="kn-search-main"><Heading data-kn-type="heading-5">{heading}</Heading>
    <div class="kn-search-row"><input data-kn-surface="page" type="search" name="q" value={search?.value} placeholder={search?.label ?? 'Search the site'} aria-label={search?.label ?? 'Search the site'} /><Button type="submit">{submitLabel}</Button></div></div>
    {suggestions.length > 0 && <ul class="kn-search-links">{suggestions.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>}
  </div> : <div class="kn-visitor-filter-panel">
    {select && <div class="kn-field kn-visitor-filter-select"><label class="kn-field-label" for={`${id}-select`}>{select.label}</label><span class="kn-field-select"><select class="kn-field-control" id={`${id}-select`} name={select.name} aria-controls={controls}>{select.options.map((option) => <option value={option.value} selected={select.value === option.value} disabled={option.disabled} data-kn-match={key(select.name, option.value)}>{option.label}</option>)}</select><Icon name="chevron-down" /></span></div>}
    {toggles.map((group) => <fieldset class="kn-visitor-filter-group"><legend>{group.label}</legend><div class="kn-visitor-filter-toggles">{group.options.map((option) => <label class="kn-pill"><input type="checkbox" name={group.name} value={option.value} checked={group.values?.includes(option.value) ?? false} disabled={option.disabled} aria-controls={controls} data-kn-match={key(group.name, option.value)} />{option.label}</label>)}</div></fieldset>)}
    {search && <div class="kn-field kn-visitor-filter-search"><label class="kn-field-label" for={`${id}-search`}>{search.label}</label><div class="kn-visitor-filter-input"><Icon name="search" /><input class="kn-field-control" id={`${id}-search`} name="q" type="search" value={search.value} /></div></div>}
    <Button class="kn-visitor-filter-submit" type="submit" variant="outline">{submitLabel}</Button>
  </div>}
  <p class="kn-visitor-filter-count" data-kn-type="small">{countText.replace('{count}', String(total)).replace('{total}', String(total))}</p>
</form>

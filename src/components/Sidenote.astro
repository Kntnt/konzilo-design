---
import type { HTMLAttributes } from 'astro/types';
// Place immediately after the flow element to which this note belongs.
interface Props extends HTMLAttributes<'aside'> {
  heading?: string;
  level?: 1 | 2 | 3 | 4 | 5 | 6;
}
const { heading, level = 3, class: className, ...attributes } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
---
<aside {...attributes} class:list={['kn-sidenote', className]} data-kn-type="small">
  {heading && <Heading data-kn-type="heading-6">{heading}</Heading>}
  <slot />
</aside>

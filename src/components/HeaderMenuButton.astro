---
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { MenuButton } from './frame-types';
interface Props { controls: string; button?: MenuButton; automatic?: boolean }
const { controls, button = {}, automatic = false } = Astro.props;
const { word = 'Menu', icon = 'chevron-down', label = 'Menu' } = button;
---
<Button class="kn-header-menu-button kn-header-control" variant="outline" aria-expanded="false" aria-controls={controls} aria-label={label} popovertarget={controls} data-kn-trigger="menu" data-kn-automatic={automatic ? 'true' : undefined} data-kn-icon={word ? icon || 'none' : 'menu'}>
  {word && <span class="kn-header-menu-word">{word}</span>}
  {word && icon === 'chevron-down' && <Icon name="chevron-down" class="kn-header-chevron" />}
  <Icon name="menu" class="kn-header-hamburger" />
</Button>

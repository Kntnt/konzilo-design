---
import type { MenuItem, Language, Search, Cta, Level, Surface } from './frame-types';
import LanguageSwitcher from './LanguageSwitcher.astro';
import SearchPanel from './SearchPanel.astro';
import Button from './Button.astro';
interface Props {
  id: string; items: MenuItem[]; level?: Level; numbered?: boolean; surface?: Surface;
  languages?: Language[]; search?: Search; cta?: Cta;
}
const { id, items, level = 2, numbered = false, surface = 'page', languages = [], search, cta } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
---
<nav id={id} class="kn-header-panel kn-megamenu" data-kn-panel="menu" aria-label="Main menu" data-kn-surface={surface} popover="auto">
  <div class="kn-megamenu-inner">
    {(search || languages.length || cta) && <div class="kn-header-moved">
      {search && <SearchPanel search={search} inline />}
      {languages.length > 0 && <LanguageSwitcher languages={languages} inline />}
      {cta && <Button class="kn-header-cta" href={cta.href} data-kn-dialog={cta.dialog} aria-haspopup={cta.dialog ? 'dialog' : undefined} aria-controls={cta.dialog} data-kn-moved="cta">{cta.label}</Button>}
    </div>}
    {Astro.slots.has('above') && <div class="kn-megamenu-above"><slot name="above" /></div>}
    {items.length > 0 && <div class="kn-megamenu-columns" style={{ '--kn-header-menu-columns': Math.min(5, items.length) }}>
      {items.map((item, i) => <div class="kn-megamenu-column">
        <Heading class="kn-megamenu-heading" data-kn-type="heading-6"><a href={item.href} aria-current={item.current ? 'page' : undefined}>
          {numbered && <span class="kn-megamenu-number" aria-hidden="true">{String(i + 1).padStart(2, '0')} /</span>}{item.label}
        </a></Heading>
        {item.children?.length && <ul>{item.children.map((child) => <li><a href={child.href} aria-current={child.current ? 'page' : undefined}><span>{child.label}</span>{child.description && <span class="kn-megamenu-description">{child.description}</span>}</a></li>)}</ul>}
      </div>)}
    </div>}
    {Astro.slots.has('below') && <div class="kn-megamenu-below"><slot name="below" /></div>}
  </div>
</nav>

---
import type { MenuItem, Language, Search, Cta, Level, Surface } from './frame-types';
import LanguageSwitcher from './LanguageSwitcher.astro';
import SearchPanel from './SearchPanel.astro';
import Button from './Button.astro';
interface Props {
  id: string; items: MenuItem[]; level?: Level; numbered?: boolean; surface?: Surface;
  languages?: Language[]; search?: Search; cta?: Cta;
  // Whether the rows above and below the columns show. Astro counts a slot written inside a condition as filled even
  // when the condition is false, so the Header says it outright; on its own the menu goes by its slots.
  above?: boolean; below?: boolean;
}
const { id, items, level = 2, numbered = false, surface = 'page', languages = [], search, cta, above = Astro.slots.has('above'), below = Astro.slots.has('below') } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
// An entry with entries under it heads a column of them; one without stands as a link in a row after the columns, rather
// than as a column with nothing in it (the assistant's choice, which the owner may veto). A description shows under its
// entry, in a column's heading, among its links and in the row alike.
const hasChildren = (item: MenuItem) => (item.children?.length ?? 0) > 0;
const columns = items.filter(hasChildren);
const singles = items.filter((item) => !hasChildren(item) && item.href);
// A modal dialog that the menu button opens with no script: Esc and a click outside close it, focus stays in it and
// returns to the button.
---
<dialog id={id} class="kn-header-panel kn-megamenu" data-kn-panel="menu" aria-label="Menu" data-kn-surface={surface} closedby="any">
  <nav class="kn-megamenu-inner" aria-label="Main menu">
    {(search || languages.length || cta) && <div class="kn-header-moved">
      {search && <SearchPanel search={search} inline />}
      {languages.length > 0 && <LanguageSwitcher languages={languages} inline />}
      {cta && <Button class="kn-header-cta" href={cta.href} commandfor={cta.href === undefined ? cta.dialog : undefined} command={cta.href === undefined && cta.dialog ? 'show-modal' : undefined} aria-haspopup={cta.href === undefined && cta.dialog ? 'dialog' : undefined} aria-controls={cta.href === undefined ? cta.dialog : undefined} data-kn-moved="cta">{cta.label}</Button>}
    </div>}
    {above && <div class="kn-megamenu-above"><slot name="above" /></div>}
    {columns.length > 0 && <div class="kn-megamenu-columns" style={{ '--kn-header-menu-columns': Math.min(6, columns.length) }}>
      {columns.map((item, i) => <div class="kn-megamenu-column">
        <Heading class="kn-megamenu-heading" data-kn-type="heading-6"><a href={item.href} aria-current={item.current ? 'page' : undefined}>
          {numbered && <span class="kn-megamenu-number" aria-hidden="true">{String(i + 1).padStart(2, '0')} /</span>}{item.label}
        </a></Heading>
        {item.description && <p class="kn-megamenu-description">{item.description}</p>}
        <ul>{item.children!.map((child) => <li><a href={child.href} aria-current={child.current ? 'page' : undefined}><span>{child.label}</span>{child.description && <span class="kn-megamenu-description">{child.description}</span>}</a></li>)}</ul>
      </div>)}
    </div>}
    {singles.length > 0 && <ul class="kn-megamenu-links">
      {singles.map((item) => <li><a href={item.href} aria-current={item.current ? 'page' : undefined}><span data-kn-type="heading-6">{item.label}</span>{item.description && <span class="kn-megamenu-description">{item.description}</span>}</a></li>)}
    </ul>}
    {below && <div class="kn-megamenu-below"><slot name="below" /></div>}
  </nav>
</dialog>

---
import type { HTMLAttributes } from 'astro/types';
import type { FooterCellData, Surface } from './frame-types';
interface Props extends HTMLAttributes<'div'> {
  cell: FooterCellData; surface?: Surface; row?: number; compact?: boolean; ownB?: boolean;
  edgeTop?: boolean; edgeBottom?: boolean; stackFirst?: boolean; stackLast?: boolean;
}
const { cell, surface, row = 1, compact = false, ownB = false, edgeTop = false, edgeBottom = false, stackFirst = false, stackLast = false, class: className, ...attributes } = Astro.props;
const Heading = `h${cell.level ?? 2}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
---
<div {...attributes} class:list={['kn-footer-cell', className]} data-kn-cell={`${cell.column}${row}`} data-kn-column={cell.column} data-kn-surface={surface} data-kn-columns={cell.columns ?? 1} data-kn-align={cell.align} data-kn-compact={compact || undefined} data-kn-own-b={ownB || undefined} data-kn-edge-top={edgeTop || undefined} data-kn-edge-bottom={edgeBottom || undefined} data-kn-stack-first={stackFirst || undefined} data-kn-stack-last={stackLast || undefined} style={{ 'grid-row': `r${row}-start / r${row + (cell.rows ?? 1) - 1}-end` }}>
  {cell.heading && <Heading data-kn-type="heading-5">{cell.heading}</Heading>}
  {cell.text && <p class="kn-footer-muted">{cell.text}</p>}
  {cell.links?.length && <ul class="kn-footer-links">{cell.links.map((link) => <li><a href={link.href} data-kn-consent-open={link.consentOpen || undefined} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>)}</ul>}
  <slot><Fragment set:html={cell.content ?? ''} /></slot>
</div>

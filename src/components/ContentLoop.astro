---
import type { HTMLAttributes } from 'astro/types';
import type { Level, Surface } from './frame-types';
import type { ContentItem, ContentParts, ContentCta, MetaSeparator } from './interaction-types';
import { nextId } from './ids.js';
import { recogniseEmbed } from './embed-providers.js';
import { filterGroups, filterKeys, itemMatches } from './visitor-filters.js';
import ContentCard from './ContentCard.astro';
import ContentRow from './ContentRow.astro';
interface Props extends HTMLAttributes<'div'> {
  items: ContentItem[]; presentation?: 'cards' | 'rows'; level?: Level; type?: ContentParts['type']; surface?: Surface;
  columns?: 1 | 2 | 3 | 4; images?: boolean; imageRatio?: '2:1' | '3:2' | '1:1'; imageInset?: boolean;
  metaSeparator?: MetaSeparator; cta?: ContentCta; itemProps?: Partial<ContentParts>; empty?: string;
  galleryNote?: string; closeLabel?: string;
  // The `toggles` and `select` of the Visitor Filters over this loop, so each item carries the keys its pills match.
  filteredBy?: { toggles?: { name: string; options: { value: string }[] }[]; select?: { name: string; options: { value: string }[] } };
}
const { items, presentation = 'cards', level = 3, type = 'heading-5', surface, columns = 3, images = true, imageRatio = '3:2', imageInset = false, metaSeparator = 'dot', cta, itemProps = {}, empty = 'No items found.', galleryNote, closeLabel = 'Close content', filteredBy, id = nextId('kn-content-loop'), class: className, ...attributes } = Astro.props;
items.filter((item) => item.kind === 'video').forEach((item) => recogniseEmbed(item.href));
const keys = filteredBy ? filterKeys(filterGroups(filteredBy)) : undefined;
const data = (item: ContentItem) => ({ 'data-kn-item': '', 'data-kn-matches': keys ? itemMatches(keys, item.filters) : undefined });
const parts = ({ surface: itemSurface, group, filters, ...item }: ContentItem) => ({ ...itemProps, ...item, level: item.level ?? level, type: item.type ?? type, picture: images ? item.picture ?? itemProps.picture : undefined, metaSeparator: item.metaSeparator ?? metaSeparator, cta: item.cta ?? cta, linkAttributes: { ...item.linkAttributes, ...(item.kind === 'video' ? { 'data-kn-embed-overlay': '', 'data-kn-embed-title': item.title, 'data-kn-embed-close': closeLabel, 'data-kn-gallery-note': galleryNote } : {}) } });
---
<div {...attributes} id={id} class:list={['kn-content-loop', className]} data-kn-presentation={presentation}>
  <ul class:list={['kn-content-items', presentation === 'cards' ? 'kn-card-grid' : 'kn-content-rows']} data-kn-columns={columns} role="list">{items.map((item, index) => <>
    {item.group && item.group !== items[index - 1]?.group && <li class="kn-content-group" data-kn-content-group={item.group} data-kn-type="small"><span>{item.group}</span></li>}
    <li class="kn-content-item" {...data(item)}>{presentation === 'cards' ? <ContentCard {...parts(item)} surface={item.surface ?? surface} imageRatio={imageRatio === '1:1' ? '3:2' : imageRatio} imageInset={imageInset} /> : <ContentRow {...parts(item)} images={images} surface={item.surface ?? surface} imageRatio={imageRatio === '2:1' ? '3:2' : imageRatio} />}</li>
  </>)}</ul>
  <p class="kn-content-loop-empty" hidden={items.length > 0}>{empty}</p>
</div>
<script>
  import { setupEmbeds } from './embed.js';
  setupEmbeds();
</script>

---
import { nextId } from './ids.js';
import type { HTMLAttributes } from 'astro/types';
import type { Level, Surface } from './frame-types';
import type { ContentHeading } from './content-types';
import { contentsTree } from './table-of-contents.js';
import TableOfContentsList from './TableOfContentsList.astro';
interface Props extends HTMLAttributes<'nav'> {
  headings: ContentHeading[];
  depth?: 2 | 3 | 4 | 5 | 6;
  label?: string;
  level?: Level;
  surface?: Surface;
}
const { headings, depth = 2, label = 'Contents', level, surface, class: className, ...attributes } = Astro.props;
const entries = contentsTree(headings, depth);
const count = headings.filter((heading) => heading.depth >= 2 && heading.depth <= depth).length;
const labelId = nextId('kn-toc-label');
const Label = (level ? `h${level}` : 'p') as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p';
---
{count >= 2 && <nav {...attributes} class:list={['kn-toc', className]} aria-labelledby={labelId} data-kn-type="small" data-kn-surface={surface}>
  <Label class="kn-toc-label" id={labelId} data-kn-type="heading-6">{label}</Label>
  <TableOfContentsList entries={entries} />
</nav>}

---
import { nextId } from './ids.js';
import type { HTMLAttributes } from 'astro/types';
import type { Identity, MenuItem, MenuButton, Language, Search, Cta, Level } from './frame-types';
import { arrangementGroups, givingWaySteps } from './header.js';
import scrollTimelinePolyfill from './scroll-timeline-polyfill.js?url&no-inline';
import scrollStatePolyfill from './scroll-state-polyfill.js?url&no-inline';
import headerFit from './header-fit.js?raw';
import HeaderIdentity from './HeaderIdentity.astro';
import HeaderLinkMenu from './HeaderLinkMenu.astro';
import HeaderMenuButton from './HeaderMenuButton.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Button from './Button.astro';
import SearchPanel from './SearchPanel.astro';
import Megamenu from './Megamenu.astro';
import SkipLink from './SkipLink.astro';
interface Props extends HTMLAttributes<'header'> {
  identity: Identity; arrangement?: 'A' | 'B' | 'C'; attachment?: 'flow' | 'sticky';
  start?: 'below' | 'under'; autohide?: boolean; surface?: 'page' | 'brand';
  menu?: MenuItem[]; linkMenu?: boolean; menuButton?: MenuButton | false;
  languages?: Language[]; search?: Search; cta?: Cta; level?: Level; numbered?: boolean;
  skipTo?: string;
}
const { identity, arrangement = 'A', attachment = 'flow', start = 'below', autohide = false, surface = 'page', menu = [], linkMenu = false, menuButton = false, languages = [], search, cta, level = 2, numbered = false, skipTo = '#content', id = nextId('kn-header'), class: className, ...attributes } = Astro.props;
// Page start and sliding away are a sticky header's only.
const sticky = attachment === 'sticky';
const slides = sticky && autohide;
const inLinkMenu = linkMenu && menu.some((item) => item.linkMenu !== false);
const hasMenu = !!menuButton || inLinkMenu || !!search || languages.length > 0 || !!cta;
const groups = arrangementGroups(arrangement, { links: inLinkMenu, menu: hasMenu, language: languages.length > 0, search: !!search, cta: !!cta });
const button = menuButton || { word: linkMenu ? 'Menu' : '', icon: 'menu' as const };
// The steps this header can take, in order, for header-fit.js to measure; the last resort, `scale`, follows them all.
const steps = givingWaySteps({ slogan: !!identity.slogan, logo: !!identity.logo, name: !!identity.name, links: inLinkMenu, word: hasMenu && (button.word ?? 'Menu') !== '', language: languages.length > 0, cta: !!cta, search: !!search });
// Written inline in every page, so without its comments.
const headerFitScript = headerFit.replace(/^\s*\/\/.*\n/gm, '');
const opens = (target?: string) => (target ? { commandfor: target, command: 'show-modal', 'aria-haspopup': 'dialog', 'aria-controls': target } : {});
---
<header {...attributes} id={id} class:list={['kn-header', className]} data-kn-arrangement={arrangement} data-kn-attachment={attachment} data-kn-start={sticky ? start : 'below'} data-kn-autohide={String(slides)} data-kn-surface={surface} data-kn-steps={steps.join(' ')}>
  <SkipLink href={skipTo} />
  <div class="kn-header-bar"><div class="kn-header-inner">
    <div class="kn-header-row">
      {groups.map((group, i) => <div class="kn-header-group" data-kn-group={i === 0 ? 'start' : 'end'}>{group.map((item) => <>
        {item === 'identity' && <HeaderIdentity identity={identity} />}
        {item === 'links' && <HeaderLinkMenu items={menu} />}
        {item === 'search' && <Button class="kn-header-control kn-header-icon-button kn-header-search-trigger" variant="outline" icon="search" aria-label="Search" {...opens(`${id}-search`)} data-kn-trigger="search" />}
        {item === 'language' && <LanguageSwitcher languages={languages} id={`${id}-languages`} />}
        {item === 'menu' && <HeaderMenuButton controls={`${id}-menu`} button={button} automatic={!menuButton} />}
        {item === 'cta' && <Button href={cta?.href} class="kn-header-cta" {...opens(cta?.href === undefined ? cta?.dialog : undefined)}>{cta?.label}</Button>}
      </>)}</div>)}
      {hasMenu && <Megamenu id={`${id}-menu`} items={menu} level={level} numbered={numbered} languages={languages} search={search} cta={cta}>
        {Astro.slots.has('menu-above') && <Fragment slot="above"><slot name="menu-above" /></Fragment>}
        {Astro.slots.has('menu-below') && <Fragment slot="below"><slot name="menu-below" /></Fragment>}
      </Megamenu>}
      {search && <SearchPanel search={search} id={`${id}-search`} level={level} />}
    </div>
  </div></div>
  {/* The script that measures giving way, inline and last, so it fits this header before the page paints; then the
      polyfills, each loaded only where the browser lacks its feature (header.md, How it is built). */}
  <script is:inline data-kn-header-fit set:html={headerFitScript}></script>
  {sticky && <script is:inline data-kn-polyfill="scroll-timeline" define:vars={{ src: scrollTimelinePolyfill }}>if (!CSS.supports('animation-timeline: scroll()')) import(src);</script>}
  {slides && <script is:inline data-kn-polyfill="scroll-state" define:vars={{ src: scrollStatePolyfill }}>if (!CSS.supports('container-type: scroll-state')) import(src);</script>}
</header>

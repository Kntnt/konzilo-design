---
// "Read more" under a post (docs/spec/directives.md, An article, "Read more"): its related posts as teaser cards under a
// heading, and a lone main action to the rest; nothing where there are none.
//
//   <ReadMore posts={await relatedPosts(article)} more={{ label: 'More articles', href: '/articles/' }} surface="raised" />
//
// `posts` as the core's relatedPosts() gives them, each { entry, url }; `heading` the page's context's word by default.
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { contextOf } from '../directives/render/context.js';
import { teaserImageOf, teaserOf } from '../presentations/teasers.js';
import { readMore, readMorePicture } from './parts.js';

const { posts = [], heading, more, surface } = Astro.props;
const ctx = contextOf(Astro);
// A series of so many teasers across a band, each picture as wide as the design draws an item of it there, by its
// proportions.
const pictureFor = (post) => readMorePicture(ctx, posts.length, teaserImageOf(post.entry));
const teasers = await Promise.all(posts.map((post) => teaserOf(post, { getEntry, getImage, picture: pictureFor(post) })));
---
<Fragment set:html={readMore(ctx, { teasers, heading, more, surface })} />

---
import Frame from './specimens/Frame.astro';
import Basics from './specimens/Basics.astro';
import Bands from './specimens/Bands.astro';
import Cards from './specimens/Cards.astro';
import Media from './specimens/Media.astro';
import Content from './specimens/Content.astro';
import Finding from './specimens/Finding.astro';
import Forms from './specimens/Forms.astro';
import Composition from './specimens/Composition.astro';
const { id } = Astro.props;
const groups = [
  [
    Frame,
    [
      'page',
      'band',
      'reading-area',
      'header-a-menu',
      'header-a-search',
      'footer',
    ],
  ],
  [Basics, ['body-text', 'buttons', 'links', 'icon', 'article', 'button-default']],
  [
    Bands,
    [
      'hero',
      'text-image',
      'text-image-start',
      'cta-band',
    ],
  ],
  [
    Cards,
    ['card', 'card-unplated', 'card-person', 'content-card', 'card-grid'],
  ],
  [Media, ['figure', 'embed']],
  [Content, ['table', 'accordion', 'callout', 'table-more', 'accordion-more', 'callout-more']],
  [Finding, ['content-loop', 'visitor-filters', 'search', 'breadcrumbs', 'pagination']],
  [
    Forms,
    [
      'form',
      'form-brand',
      'form-more',
      'form-states',
      'consent-banner',
      'consent-settings',
      'consent-services',
    ],
  ],
];
const Component =
  groups.find(([, ids]) => ids.includes(id))?.[0] || Composition;
---

<Component {...Astro.props} />

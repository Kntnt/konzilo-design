---
import { project, t, date } from '../data.js';
import { componentPages } from '../catalog.js';
import PageToolbar from '../PageToolbar.astro';
import PageSketch from '../PageSketch.astro';
const { page, pages } = Astro.props;
const index = pages.findIndex((entry) => entry.id === page.id);
const explanationKeys = {
  'colour-scale': 'colour',
  'main-typeface': 'typefaces',
  'type-scale': 'type-scale',
  space: 'space-shape',
  shadow: 'shadow',
  header: 'frame',
  opening: 'components',
};
const motivation = project.explanations?.[explanationKeys[page.id]];
const specimenPages = [...componentPages.map(([id]) => id), 'typography-use', 'space', 'shadow'];
const picturePages = ['page', 'opening', 'sections', 'cards', 'media', 'finding'];
const paragraphs = (text) => String(text).split(/\n\s*\n/).filter((part) => part.trim());
---
<section class:list={['document-page', page.id === 'start' && 'start-page']} id={page.id} data-page={page.id} data-title={t(`${page.id}.title`)} data-kn-surface={page.id === 'start' ? 'brand' : 'page'}>
  <header class="page-heading prose">
    <p data-kn-type="label">{t(`chapter.${page.chapter}`)}</p>
    {page.id === 'start' && (project['logo-dark'] || project.logo ? <img class="cover-logo" src={project['logo-dark'] || project.logo} alt={project.name} /> : <p data-kn-type="heading-2">{project.name}</p>)}
    <h1 tabindex="-1" data-kn-type="heading-1">{page.id === 'start' ? t('document.title') : t(`${page.id}.title`)}</h1>
    <p data-kn-type="lead">{t(`${page.id}.lead`)}</p>
    {page.id === 'start' && <p>{date} · {t('version', { version: project.version })}</p>}
  </header>
  {motivation && <aside class="motivation prose" aria-label={t('motivation.label')}>
    <p data-kn-type="label">{t('motivation.label')}</p>
    {paragraphs(motivation).map((paragraph) => <p>{paragraph}</p>)}
    {project.contact?.name && <p data-kn-type="small">{project.contact.name}</p>}
  </aside>}
  {/* The page's layout is a drawing of the design's widths, which the toolbar's switches below do not change. */}
  {page.id === 'page' && <PageSketch />}
  {specimenPages.includes(page.id) && <PageToolbar pictures={picturePages.includes(page.id)} />}
  {page.id === 'colour-together' && <PageToolbar width={false} />}
  <div class="page-content"><slot /></div>
  <nav class="page-turn" aria-label={t('nav.label')}>
    {index > 0 ? <a class="previous" href={`#${pages[index - 1].id}`}><small>{t('nav.previous')}</small><span>← {t(`${pages[index - 1].id}.title`)}</span></a> : <span />}
    {index < pages.length - 1 && <a class="next" href={`#${pages[index + 1].id}`}><small>{t('nav.next')}</small><span>{t(`${pages[index + 1].id}.title`)} →</span></a>}
  </nav>
</section>

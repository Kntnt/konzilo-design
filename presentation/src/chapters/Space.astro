---
import { resolved as r, inputs, t, num } from '../data.js';
import { range } from '../words.js';
import Button from '../../../src/components/Button.astro';
import Field from '../../../src/components/Field.astro';
import Components from './Components.astro';
const { id } = Astro.props;
---
{id === 'space' && <>
  <p class="prose">{t(inputs['density-profile'] < 35 ? 'space.compact' : inputs['density-profile'] > 70 ? 'space.loose' : 'space.balanced')}</p>
  <Components specimens={['space-section']} />
  <details><summary>{t('steps')}</summary><div class="spacing-steps">{Object.entries(r.space.steps).map(([step, value]) => <div><span>{step}</span><i style={{ width: `${value.max}px` }}></i><span>{range(value)}</span></div>)}</div></details>
</>}
{id === 'corners' && <>
  <p>{t(inputs['corner-profile'] === 0 ? 'corners.square' : inputs['corner-profile'] < 60 ? 'corners.discreet' : 'corners.round')}</p>
  <p>{t(r.frame.width ? 'frame.on' : 'frame.off', { width: num(r.frame.width) })}</p>
  <div class="shape-grid">
    <div class="shape-control"><Button>{t('shape.button')}</Button></div>
    <div class="shape-control"><Field name="shape-field" label={t('shape.field')} value={t('shape.value')} /></div>
    <div class="shape-object shape-card" data-kn-surface="tint"><h2 data-kn-type="heading-3">{t('shape.card')}</h2><p>{t('shape.card.text')}</p></div>
    <div class="shape-object shape-panel" data-kn-surface="raised"><h2 data-kn-type="heading-3">{t('shape.panel')}</h2><p>{t('shape.panel.text')}</p></div>
  </div>
</>}
{id === 'shadow' && <>
  <p class="prose">{t(Object.values(r.shadow).some((value) => value !== 'none') ? 'shadow.on' : 'shadow.off')}</p>
  <div class="shadow-grid">{Object.keys(r.shadow).map((name) => <div>
    <div class="shadow-object" data-kn-surface="raised" style={{ boxShadow: `var(--kn-shadow-${name})` }}><h2 data-kn-type="heading-4">{t(`shadow.${name}`)}</h2></div>
    <p data-kn-type="small">{t(`shadow.${name}.job`)}</p>
  </div>)}</div>
</>}

---
import { resolved as r, inputs, t, num, ownPictures } from '../data.js';
import { pictures } from '../samples.js';
import { contrast } from '../../../src/generator/color.js';
import Button from '../../../src/components/Button.astro';
const { id } = Astro.props;
const { landscapes } = pictures(r.ramps, ownPictures);
const ink = (hex) => contrast(hex, '#ffffff') >= 4.5 ? '#ffffff' : '#111111';
const primaryKinds = ['page', 'raised', 'tint', 'tint-secondary', 'tint-tertiary', 'brand', 'inverse', 'accent'].filter((kind) => r.surfaces[kind]);
const moreKinds = Object.keys(r.surfaces).filter((kind) => !primaryKinds.includes(kind));
const summary = (kind, mode) => {
  const pairs = r['contrast-check'].matrix[kind][mode].pairs;
  return t('contrast.summary', {
    text: num(pairs.text.ratio),
    muted: num(pairs['text-muted'].ratio),
    link: num(pairs.link.ratio),
  });
};
---
{id === 'colour-scale' && <>
  <div class="brand-swatches">
    {Object.entries(inputs['brand-colors']).map(([rank, hex]) => <div class="brand-column" style={{ background: hex, color: ink(hex) }}>
      <h2 data-kn-type="heading-3">{t(`colour.${rank}`)}</h2>
      <p>{hex}</p>
      <p>{t(`colour.${rank}.job`)}</p>
    </div>)}
  </div>
  {Object.entries(r.ramps).map(([name, ramp]) => <section class="ramp-row">
    <h2 data-kn-type="heading-4">{t(`colour.${name}`)}</h2>
    <div class="ramp-cells">{Object.entries(ramp).map(([step, hex]) => <div style={{ background: hex, color: ink(hex) }}><strong>{step}</strong><span>{hex}</span></div>)}</div>
  </section>)}
  <p class="prose">{t('colour.legend')}</p>
</>}
{id === 'colour-together' && <>
  <div data-colour-examples data-kn-mode="light" style={{ '--kn-sample-picture': `url("${landscapes[0]}")` }}>
    {[primaryKinds, moreKinds].map((kinds, index) => {
      const examples = <div class="surface-grid">{kinds.map((kind) => <figure>
        <div class="surface-example" data-kn-surface={kind} style={kind.startsWith('picture-') ? { '--kn-picture-image': 'var(--kn-sample-picture)' } : undefined}>
          <p data-kn-type="label">{t(`surface.${kind}`)}</p>
          <h2 data-kn-type="heading-3">{t('surface.sample')}</h2>
          <p>{t('surface.text')}</p>
          <p><a href="#colour-together">{t('surface.link')}</a></p>
          <Button>{t('surface.button')}</Button>
        </div>
        <figcaption data-kn-type="small" data-ratios={JSON.stringify({ light: summary(kind, 'light'), dark: summary(kind, 'dark') })}>{summary(kind, 'light')}</figcaption>
      </figure>)}</div>;
      return examples;
    })}
  </div>
  <section class="prose reference"><h2 data-kn-type="heading-4">{t('contrast.help')}</h2><p>{t('contrast.explain')}</p></section>
</>}

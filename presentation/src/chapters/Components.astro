---
import { t } from '../data.js';
const { page } = Astro.props;
---

{page.id !== 'responsive' ? (
  <div class="frame-host" data-frame-host>
    <iframe
      data-specimen-frame={page.id}
      data-stage-mode={page.stage}
      title={t(`${page.id}.title`)}
      width="1440"
      height="562"
    />
  </div>
) : (
  <div class="responsive-comparison rail">
    {['hero', 'grid', 'footer'].map((part) => (
      <div>
        <p data-kn-type="label">{t(`responsive.${part}`)}</p>
        <div class="responsive-host">
          <iframe
            data-specimen-frame={`responsive-${part}`}
            data-responsive-width="390"
            title={t(`responsive.${part}`)}
            width="390"
            height="530"
          />
        </div>
      </div>
    ))}
  </div>
)}

---
import { resolved as r, inputs, t, num, copy } from '../data.js';
import { faceName, families, rolesFor, typeOrder } from '../words.js';
import Components from './Components.astro';
const { id } = Astro.props;
const main = r.typefaces.main;
const otherFamilies = families.filter((family) => family !== main);
const recipeFamily = (style) => {
  if (['body', 'lead', 'small', 'eyebrow'].includes(style)) return r.typefaces.main;
  if (style === 'label') return r.typefaces.label;
  if (style === 'mono') return r.typefaces.monospace;
  if (style === 'display') return r.typefaces.display;
  if (style === 'heading-1') return r.typefaces['heading-1'] || r.typefaces.heading;
  return r.typefaces.heading;
};
const recipes = Object.entries(r.type).filter(([style]) => recipeFamily(style) === main).map(([, recipe]) => recipe);
const weights = [...new Set(recipes.map((recipe) => recipe.weight))];
const tuning = recipes.find((recipe) => recipe.features)?.features;
const characters = t('type.characters').split(/\s+/);
const breakpoints = r['type-scale'].breakpoints;
const scale = (ratio) => t(Object.hasOwn(copy, `scale.${ratio}`) ? `scale.${ratio}` : 'scale.custom', { ratio: num(ratio, 3) });
---
{id === 'main-typeface' && <div class="face" style={{ fontFamily: main }}>
  <p class="face-name">{faceName(main)}</p>
  <div class="alphabet">{characters.map((line) => <p>{line}</p>)}</div>
  <div class="weights">{weights.map((weight) => <div>
    <p class="weight-word" style={{ fontWeight: weight }}>{t(`weight.${Math.min(900, Math.max(100, Math.round(weight / 100) * 100))}`)}</p>
    <p data-kn-type="label">{num(weight)}</p>
  </div>)}</div>
  {tuning && <section class="tuning">
    <p class="prose">{t('type.tuning')}</p>
    <div class="tuning-pair">{['before', 'after'].map((state) => <div>
      <p data-kn-type="label">{t(`type.${state}`)}</p>
      <p class="tuning-sample" style={{ fontFeatureSettings: state === 'before' ? 'normal' : tuning.value }}>{t('type.tuning-sample')}</p>
    </div>)}</div>
  </section>}
</div>}
{id === 'type-scale' && <>
  <p class="prose">{t(breakpoints.min === breakpoints.max ? 'type.scale-explain-step' : 'type.scale-explain', { narrow: scale(inputs.type.ratio.min), wide: scale(inputs.type.ratio.max), from: num(breakpoints.min), to: num(breakpoints.max) })}</p>
  <div class="scale-control">
    <label for="type-window">{t('type.slider')}</label>
    <output id="type-window-value">{t('value.px', { value: num(breakpoints.max) })}</output>
    <input id="type-window" type="range" min="320" max="1920" value={breakpoints.max} />
    <span data-kn-type="small">{t('type.slider-min', { value: num(320) })}</span>
    <span class="scale-end" data-kn-type="small">{t('type.slider-max', { value: num(1920) })}</span>
  </div>
  <div class="scale-lines">{typeOrder.map((style) => <div class="scale-line">
    <p data-kn-type="small">{t(`type.${style}`)} · <output data-type-size={style}>{t('value.px', { value: num(r.type[style].size.max) })}</output></p>
    <p data-kn-type={style} data-scale-style={style} style={{ fontSize: `${r.type[style].size.max}px` }}>{t('type.sample')}</p>
  </div>)}</div>
</>}
{id === 'other-typefaces' && <>
  {otherFamilies.length === 0 && <p>{t('type.other-none')}</p>}
  {otherFamilies.map((family) => <section class="face face-other" style={{ fontFamily: family }}>
    <h2 class="face-name" style={{ fontFamily: family }}>{faceName(family)}</h2>
    <p class="face-where" style={{ fontFamily: main }}>{t('type.where', { roles: rolesFor(family) })}</p>
    <div class="alphabet">{characters.map((line) => <p>{line}</p>)}</div>
    {family === r.typefaces.label && <p class="face-sample" data-kn-type="label">{t('labels.sample')}</p>}
    {family === r.typefaces.monospace && <pre class="code-sample"><code>{t('type.code')}</code></pre>}
  </section>)}
  {r.typefaces.label === main && <p class="face-sample" data-kn-type="label">{t('labels.sample')}</p>}
</>}
{id === 'typography-use' && <Components specimens={['article']} />}

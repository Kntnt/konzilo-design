---
import { t } from './data.js';
const { width = true, pictures = false } = Astro.props;
const widths = [['wide', 'window.wide'], ['768', 'window.tablet'], ['390', 'window.phone']];
const modes = [['light', 'mode.light'], ['dark', 'mode.dark']];
const showing = [['on', 'pictures.on'], ['off', 'pictures.off']];
// The reader's own switches belong to the document, not to the design it shows: they stand on the sidebar's Surface,
// each named, and the chosen one is plain text colour, never the design's button, so no sample looks like one of them.
const settings = [
  width && ['window.label', 'data-frame-width', widths],
  pictures && ['pictures.label', 'data-frame-pictures', showing],
  ['mode.label', 'data-frame-mode', modes],
].filter(Boolean);
---
<div class="page-toolbar" data-kn-surface="raised">
  {settings.map(([label, hook, options]) => (
    <div class="toolbar-setting">
      <span class="toolbar-label" data-kn-type="label" aria-hidden="true">{t(label)}</span>
      <div class="segmented" role="group" aria-label={t(label)} {...{ [hook]: '' }}>
        {options.map(([value, key], index) => (
          <button type="button" data-value={value} aria-pressed={String(index === 0)}>{t(key)}</button>
        ))}
      </div>
    </div>
  ))}
</div>

---
// Only the design tool uses these: a header with every item, for each arrangement, to leave items out of. A design's
// own menu takes the sample's place in it, its entries made from the first column's, so that column keeps links with
// descriptions under its heading (frame-live.js). It slides
// away, so the page carries both scroll polyfills for when the tool turns that on. Its search fields have the
// magnifier, which frame-live.js takes away where the design shows the word or nothing.
import Header from '../../src/components/Header.astro';
import { menu, search, languages, cta } from './samples.js';

const identity = { label: 'Example', href: '#home', name: 'Example', slogan: 'Slogan', logo: { light: 'data:,', dark: 'data:,' } };
---
{['A', 'B', 'C'].map((arrangement) => (
  <template data-kn-live-header={arrangement}>
    <Header identity={identity} arrangement={arrangement} attachment="sticky" autohide menu={menu} linkMenu menuButton={{ word: 'Menu' }} languages={languages} search={{ ...search, placeholder: 'icon' }} cta={cta} numbered>
      <div slot="menu-above" class="preview-menu-row">
        <p data-kn-type="label">From the journal</p>
        <p><a href="#resources">A practical guide to the first step</a></p>
      </div>
      <div slot="menu-below" class="preview-menu-row">
        <a href="#contact">Contact the team</a>
      </div>
    </Header>
  </template>
))}
<script>
  import { setupLiveFrame } from './frame-live.js';
  setupLiveFrame();
</script>

---
import Table from '../../../src/components/Table.astro';
import Accordion from '../../../src/components/Accordion.astro';
import Quotation from '../../../src/components/Quotation.astro';
import Callout from '../../../src/components/Callout.astro';
import { columns, rows, questions, plans } from '../samples.js';
const { id, catalogue } = Astro.props;
// The design tool's catalogue names each variant it shows.
const STATUSES = { info: 'Info', success: 'Success', warning: 'Warning', error: 'Error' };
const STYLES = { filled: 'Filled', outlined: 'Outlined' };
---

{id.startsWith('table') && (
  <div class:list={[id.endsWith('more') ? 'sample-pair' : 'sample-stack']}>
    {(id === 'table' ? ['page'] : ['brand']).map((surface) => (
      <div data-kn-surface={surface} class="sample-pad">
        <Table
          caption="A clear delivery plan"
          columns={columns}
          rows={rows}
          striped={surface === 'brand'}
          footer={[[{ text: 'Total hours', colspan: 2, header: true }, '68']]}
        />
      </div>
    ))}
  </div>
)}
{id.startsWith('accordion') && (
  <div class:list={[id.endsWith('more') ? 'sample-pair' : 'sample-stack']}>
    <Accordion
      variant={id === 'accordion' ? 'hairlines' : 'boxes'}
      mode="multiple"
      items={questions}
    />
  </div>
)}
{id === 'quotation' && (
  <div class="sample-stack">
    <Quotation name="Service team" context="Our approach" surface="tint">
      <p>The most useful plan makes the next step clear.</p>
    </Quotation>
  </div>
)}
{id.startsWith('callout') && (
  <div class:list={[id.endsWith('more') ? 'sample-callouts' : 'sample-stack']}>
    {(id === 'callout' ? ['filled'] : ['filled', 'outlined']).flatMap((style) =>
      (id === 'callout' ? ['info'] : ['info', 'success', 'warning', 'error']).map((variant, index) => {
        const callout = (
          <Callout
            variant={variant}
            style={style}
            title={
              [
                'Before you begin',
                'Request confirmed',
                'Check the date',
                'Address missing',
              ][index]
            }
          >
            <p>
              {
                [
                  'Keep your details ready.',
                  'We will be in touch.',
                  'Allow time for review.',
                  'Add a complete email.',
                ][index]
              }
            </p>
          </Callout>
        );
        return catalogue ? (
          <div class="catalogue-cell">
            <p class="catalogue-caption">{STATUSES[variant]} · {STYLES[style]}</p>
            {callout}
          </div>
        ) : callout;
      }),
    )}
  </div>
)}
{id === 'tabs' && (
  <div class="sample-stack">
    <div class="kn-body-text">
      <div class="kn-tabs" role="group" aria-labelledby="specimen-tabs-label">
        <div class="kn-tabs-label" id="specimen-tabs-label"><p data-kn-type="label">Ways to work with us</p></div>
        {plans.map((plan, index) => (
          <details class="kn-tabs-item" name="specimen-tabs" open={index === 0}>
            <summary class="kn-tabs-tab">{plan.tab}</summary>
            <div class="kn-tabs-panel">
              <div class="kn-tabs-text"><p>{plan.text}</p></div>
              <div class="kn-tabs-parts">
                <dl class="kn-value-list">
                  {plan.values.map(([label, value]) => (
                    <div class="kn-value-list-item"><dt data-kn-type="small">{label}</dt><dd class="kn-value-list-value">{value}</dd></div>
                  ))}
                </dl>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
)}

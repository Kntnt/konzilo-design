---
import Page from '../../../src/components/Page.astro';
import Header from '../../../src/components/Header.astro';
import Footer from '../../../src/components/Footer.astro';
import Hero from '../../../src/components/Hero.astro';
import Band from '../../../src/components/Band.astro';
import HeadingGroup from '../../../src/components/HeadingGroup.astro';
import BodyText from '../../../src/components/BodyText.astro';
import Button from '../../../src/components/Button.astro';
import LinkGroup from '../../../src/components/LinkGroup.astro';
import Card from '../../../src/components/Card.astro';
import CardGrid from '../../../src/components/CardGrid.astro';
import Form from '../../../src/components/Form.astro';
import Table from '../../../src/components/Table.astro';
import Callout from '../../../src/components/Callout.astro';
import CtaBand from '../../../src/components/CtaBand.astro';
import {
  sample,
  search,
  columns,
  rows,
  fields,
} from '../samples.js';
import { context } from './context.js';
import { ownPictures } from '../data.js';
import { headerProps, footerProps, pageProps, breadcrumbProps, heroProps, nextHeadingProps, menuOf } from '../frame.js';
import Breadcrumbs from '../../../src/components/Breadcrumbs.astro';
const { id, project, resolved } = Astro.props;
const images = context(project, resolved, ownPictures);
const { identity, landscapes, list } = images;
const trail = resolved.breadcrumbs.show ? breadcrumbProps(resolved.breadcrumbs, project) : undefined;
const below = resolved.hero.h1 === 'below';
---

{id === 'overview' && (
  <div class="overview-stage specimen-rail">
    <div class="overview-copy">
      <HeadingGroup
        eyebrow={sample.eyebrow}
        heading="A practical plan, clearly explained"
        deck="Useful information and a simple next step."
        type="heading-1"
      />
      <LinkGroup>
        <Button>{sample.action}</Button>
        <Button variant="outline">{sample.secondary}</Button>
      </LinkGroup>
      <div class="overview-colours">
        {Object.entries(resolved.ramps).map(([name, ramp]) => (
          <span style={{ background: ramp[300] }} aria-label={name}></span>
        ))}
      </div>
    </div>
    <Card
      heading="Start with a short conversation"
      text="Explain the goal, review the options and agree on the next step."
      href="#contact"
      surface="tint"
      picture={{ src: landscapes[0], alt: '' }}
    />
  </div>
)}
{id === 'space-section' && (
  <Fragment>
    <Band surface="page">
      <div class="sample-stack">
        <HeadingGroup
          eyebrow={sample.eyebrow}
          heading="Practical support at every stage"
          deck="From the first question to a clear delivery plan."
          type="heading-2"
        />
        <CardGrid columns={3}>
          {list.map((item) => (
            <Card heading={item.title} text={item.text} href="#services" surface="raised" />
          ))}
        </CardGrid>
      </div>
    </Band>
    <CtaBand surface="brand" heading="Agree on the next step" text="Describe what you need and we will help you make a plan.">
      <LinkGroup>
        <Button>{sample.action}</Button>
      </LinkGroup>
    </CtaBand>
  </Fragment>
)}
{id === 'preview' && (
  <Page {...pageProps(resolved.page)}>
    <Header slot="header" {...headerProps(resolved.header, project)} />
    <Hero data-kn-live-hero {...heroProps(resolved.hero, images)} eyebrow={sample.eyebrow} heading={sample.heading} deck={sample.deck}>
      {trail && !below && <Breadcrumbs slot="before" {...trail} />}
      <Button href="#contact">{sample.action}</Button>
    </Hero>
    <Band>
      {trail && below && <Breadcrumbs {...trail} />}
      <HeadingGroup {...nextHeadingProps(resolved.hero)} heading="Clear next steps" deck="Practical help when you need it." />
      <BodyText>
        <p>Plans, drawings and file names like <code>delivery-plan.pdf</code> stay easy to tell apart.</p>
      </BodyText>
    </Band>
    <Band surface="raised" data-preview-section="surfaces">
      <div class="sample-stack preview-services">
        <HeadingGroup
          eyebrow="Ways to start"
          heading="Three tints on a neutral ground"
          type="heading-3"
          deck="The band shows the grey scale. Each card shows one tint, when the design has its colour."
        />
        <CardGrid>
          {[
            ['tint', list[0]],
            ['tint-secondary', list[1]],
            ['tint-tertiary', list[2]],
          ].map(([surface, item]) => (
            <Card
              heading={item.title}
              text={item.text}
              href="#services"
              surface={surface}
              data-kn-needs-surface={surface}
              hidden={!resolved.surfaces[surface]}
            />
          ))}
        </CardGrid>
      </div>
    </Band>
    <Band surface="tint" data-preview-section="services">
      <div class="sample-stack preview-services">
        <HeadingGroup
          eyebrow="Services"
          heading="Practical support at every stage"
          type="heading-3"
          deck="From the first question to a clear delivery plan."
        />
        <CardGrid>
          {list.map((item) => (
            <Card
              heading={item.title}
              text={item.text}
              href="#services"
              surface="raised"
            />
          ))}
        </CardGrid>
      </div>
    </Band>
    <Band surface="page">
      <BodyText>
        {/* Display text has a place of its own here, so its role's controls show whatever the hero's heading looks like. */}
        <h2 data-kn-type="display">Information you can use</h2>
        <p>{sample.paragraph}</p>
      </BodyText>
      <LinkGroup style="margin-block-start: var(--kn-space-component-gap)">
        <Button>{sample.action}</Button>
        <Button variant="outline">{sample.secondary}</Button>
        <Button variant="arrow">{sample.link}</Button>
      </LinkGroup>
    </Band>
    <Band surface="brand">
      <Table caption="A delivery plan" columns={columns} rows={rows} />
    </Band>
    <Band surface="page">
      <div class="sample-stack">
        <Callout variant="info" title="A useful starting point">
          <p>Send a short description of what you need.</p>
        </Callout>
        <Form action="#contact" columns={2} fields={fields.slice(0, 2)}>
          <Button slot="actions">Send request</Button>
        </Form>
      </div>
    </Band>
    <Footer slot="footer" {...footerProps(resolved.footer, project, resolved.header)} />
  </Page>
)}
{id === 'responsive-hero' && (
  <>
    <Header
      identity={identity}
      menu={menuOf(project)}
      linkMenu
      menuButton={{ word: 'Menu' }}
      search={search}
    />
    <Hero
      type="display"
      heading="Clear next steps"
      deck="Practical help when you need it."
    >
      <Button href="#contact">Get started</Button>
    </Hero>
  </>
)}
{id === 'responsive-grid' && (
  <div class="sample-responsive-grid">
    <CardGrid columns={2}>
      {list.map((item, index) => (
        <Card
          heading={item.title}
          href="#planning"
          picture={item.picture}
          surface={index % 2 ? 'tint' : 'raised'}
        />
      ))}
    </CardGrid>
  </div>
)}

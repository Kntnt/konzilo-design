---
import Field from '../../../src/components/Field.astro';
import Button from '../../../src/components/Button.astro';
import VisitorFilters from '../../../src/components/VisitorFilters.astro';
import ContentLoop from '../../../src/components/ContentLoop.astro';
import Breadcrumbs from '../../../src/components/Breadcrumbs.astro';
import Pagination from '../../../src/components/Pagination.astro';
import { context } from './context.js';
import { ownPictures } from '../data.js';
import { breadcrumbProps } from '../frame.js';
const { id, project, resolved, catalogue } = Astro.props;
const { list } = context(project, resolved, ownPictures);
const results = Array.from({ length: 4 }, (_, index) => ({
  title: [
    'Planning the first stage',
    'Planning a useful review',
    'Planning the delivery',
  ][index % 3],
  href: '#guide',
  text: 'A practical guide to responsibilities, decisions and dates.',
  filters: { topic: index === 2 ? 'reports' : 'guides', year: '2026' },
}));
// One description of the controls for the form and its rows, so each row carries the keys the pills match.
const filters = {
  toggles: [{ name: 'topic', label: 'Topics', options: [{ value: 'guides', label: 'Guides' }, { value: 'reports', label: 'Reports' }] }],
  select: { name: 'year', label: 'Year', options: [{ value: '', label: 'All years' }, { value: '2026', label: '2026' }] },
};
---

{id === 'content-loop' && (
  <div class="sample-stack">
    <div>
      {catalogue && <p class="catalogue-caption">Cards</p>}
      <ContentLoop
        items={list.map(({ picture, ...item }) => item)}
        columns={3}
        surface="raised"
      />
    </div>
    <div>
      {catalogue && <p class="catalogue-caption">Rows</p>}
      <ContentLoop
        presentation="rows"
        images={false}
        items={[
          {
            title: 'Service overview',
            href: '#download',
            kind: 'document',
            fileType: 'PDF',
            fileSize: '240 KB',
            text: 'A short guide to the available services.',
          },
          { ...list[1], text: undefined, picture: undefined },
        ]}
      />
    </div>
  </div>
)}
{id === 'visitor-filters' && (
  <div class="sample-results">
    <VisitorFilters
      for="resources"
      search={{ label: 'Search resources', value: 'planning' }}
      toggles={filters.toggles}
      select={filters.select}
      total={results.length}
      countText="{count} results"
    />
    <ContentLoop
      id="resources"
      items={results.map(({ text, ...item }) => item)}
      presentation="rows"
      images={false}
      filteredBy={filters}
    />
  </div>
)}
{id === 'breadcrumbs' && (
  <div class="sample-stack breadcrumb-examples">
    {['page', 'tint', 'brand'].map((surface) => (
      <div class="sample-pad" data-kn-surface={surface}>
        {/* The component's own specimen shows how a trail looks, whether or not the design shows one on its pages. */}
        <Breadcrumbs {...breadcrumbProps({ ...resolved.breadcrumbs, show: true }, project)} />
      </div>
    ))}
  </div>
)}
{id === 'pagination' && (
  <div class="sample-stack">
    <Pagination page={2} pages={8} href={(number) => `#page-${number}`} />
  </div>
)}

{id === 'search' && (
  <div class="search-results-composition">
    <form class="search-results-query" role="search">
      <Field
        name="query"
        type="search"
        label="Search resources"
        value="planning"
      />
      <Button type="submit">Search</Button>
    </form>
    <p data-kn-type="small">12 results for “planning”</p>
    <ContentLoop
      items={results.slice(0, 3)}
      presentation="rows"
      images={false}
    />
    <Pagination page={1} pages={4} href={(number) => `#results-${number}`} />
  </div>
)}

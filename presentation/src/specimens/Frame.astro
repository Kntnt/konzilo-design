---
import Header from '../../../src/components/Header.astro';
import Footer from '../../../src/components/Footer.astro';
import Page from '../../../src/components/Page.astro';
import Band from '../../../src/components/Band.astro';
import HeadingGroup from '../../../src/components/HeadingGroup.astro';
import BodyText from '../../../src/components/BodyText.astro';
import ReadingArea from '../../../src/components/ReadingArea.astro';
import TableOfContents from '../../../src/components/TableOfContents.astro';
import AsideBlock from '../../../src/components/AsideBlock.astro';
import { sample, headings } from '../samples.js';
import { headerProps, footerProps, pageProps } from '../frame.js';
const { id, project, resolved } = Astro.props;
---

{id.startsWith('header-') && <Header {...headerProps(resolved.header, project)} />}
{id === 'footer' && <Footer {...footerProps(resolved.footer, project, resolved.header)} />}
{id === 'page' && (
  <Page {...pageProps(resolved.page)}>
    <Header slot="header" {...headerProps(resolved.header, project)} />
    <Band surface="tint">
      <HeadingGroup
        heading="Plan the next stage"
        deck="A short introduction explains the purpose of the page."
        type="heading-3"
      />
    </Band>
    <Footer slot="footer" {...footerProps(resolved.footer, project, resolved.header)} />
  </Page>
)}
{id === 'band' && (
  <div class="sample-stack sample-bands">
    {['tint', 'brand', 'inverse'].map((surface) => (
      <Band surface={surface} data-look={`band-colour:${surface}`}>
        <HeadingGroup
          eyebrow="A band"
          heading="A Surface marks a section"
          type="heading-3"
          deck="The content stays on the same rail as the header and footer."
        />
      </Band>
    ))}
  </div>
)}
{id === 'reading-area' && (
  <ReadingArea>
    <AsideBlock slot="aside" surface="tint">
      <TableOfContents headings={headings} />
    </AsideBlock>
    <BodyText>
      <h2 id="planning" data-kn-type="heading-3">
        Plan the work
      </h2>
      <p>{sample.paragraph}</p>
      <h3 id="review" data-kn-type="heading-4">
        Review the options
      </h3>
      <p>{sample.paragraph}</p>
      <h2 id="delivery" data-kn-type="heading-3">
        Agree on delivery
      </h2>
      <p>A clear plan keeps responsibilities visible.</p>
    </BodyText>
  </ReadingArea>
)}
